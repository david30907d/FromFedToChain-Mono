{
  "$schema": "https://json.schemastore.org/jscpd.json",
  "threshold": 0.5,
  "reporters": ["console", "json"],
  "output": ".jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/coverage/**",
    "**/.turbo/**"
  ],
  "gitignore": true,
  "minLines": 5,
  "minTokens": 60,
  "exitCode": 1,
  "mode": "strict"
}
